{
  "permissions": {
    "allow": [
      "Bash(mise run build:*)",
      "Bash(mise run test:*)"
    ]
  },
  "enabledPlugins": {},
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
