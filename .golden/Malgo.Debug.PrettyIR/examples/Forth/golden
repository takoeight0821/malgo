sig nextToken : String -> Maybe({val : String, rest : String})

def nextToken =
  fn {
    src ->
      {
        let src1 = dropWhileString(isWhiteSpace)(src)
        if(eqString(src1)(""))( fn {
          _ ->
            {
              Nothing
            }
        } )( fn {
          _ ->
            {
              let tok = takeWhileString(notWhiteSpace)(src1)
              let rest = dropWhileString(notWhiteSpace)(src1)
              Just({val = tok, rest = rest})
            }
        } )
      }
  }

sig tokenize : String -> List(String)

def tokenize =
  fn {
    src ->
      {
        case(nextToken(src))( fn {
          Nothing ->
            {
              Nil
            } |
          Just({val = tok, rest = rest}) ->
            {
              Cons(tok)(tokenize(rest))
            }
        } )
      }
  }

sig splitLines : String -> List(String)

def splitLines =
  fn {
    src ->
      {
        if(eqString(src)(""))( fn {
          _ ->
            {
              Nil
