  fn {
    word state ->
      {
        case(word)( fn {
          Builtin(handler) ->
            {
              handler(state)
            } |
          UserDef(toks) ->
            {
              execTokens(state)(toks)
            }
        } )
      }
  }

def execTokens =
  fn {
    state Nil ->
      {
        Right(state)
      } |
    state Cons(tok, rest) ->
      {
        if(state.compiling)( fn {
          _ ->
            {
              if(eqString(tok)(";"))( fn {
                _ ->
                  {
                    execTokens(exitCompile(state))(rest)
                  }
              } )( fn {
                _ ->
