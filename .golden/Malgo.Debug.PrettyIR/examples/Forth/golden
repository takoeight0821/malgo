sig dictLookup : String -> Dict -> Maybe(ForthWord)

def dictLookup =
  fn {
    _ DictEmpty ->
      {
        Nothing
      } |
    name DictBind(n, w, rest) ->
      {
        if(eqString(name)(n))( fn {
          _ ->
            {
              Just(w)
            }
        } )( fn {
          _ ->
            {
              dictLookup(name)(rest)
            }
        } )
      }
  }

sig dictInsert : String -> ForthWord -> Dict -> Dict

def dictInsert =
  fn {
    name word dict ->
      {
        DictBind(name)(word)(dict)
      }
  }

sig withStack : List(ForthVal) -> ForthState -> ForthState

def withStack =
  fn {
    s state ->
      {
        { stack = s
        , dict = state.dict
        , compiling = state.compiling
        , compileName = state.compileName
        , compileBuffer = state.compileBuffer }
      }
  }

sig enterCompile : String -> ForthState -> ForthState

def enterCompile =
  fn {
    name state ->
      {
        { stack = state.stack
        , dict = state.dict
        , compiling = True
        , compileName = name
        , compileBuffer = Nil }
      }
  }

sig exitCompile : ForthState -> ForthState

def exitCompile =
  fn {
    state ->
      {
        let newWord = UserDef(reverse(state.compileBuffer))
        let newDict = dictInsert(state.compileName)(newWord)(state.dict)
        { stack = state.stack
        , dict = newDict
        , compiling = False
        , compileName = ""
        , compileBuffer = Nil }
      }
  }

sig appendToken : String -> ForthState -> ForthState

def appendToken =
  fn {
    tok state ->
      {
        { stack = state.stack
        , dict = state.dict
        , compiling = state.compiling
        , compileName = state.compileName
        , compileBuffer = Cons(tok)(state.compileBuffer) }
      }
  }

