                   (do
                      (apply
                         putStrLn
                         (apply toStringInt32 (opapp * (int32 6) (int32 7)))))
                   (do (apply putStr (string "42 / 6 = ")))
                   (do
                      (apply
                         putStrLn
                         (apply toStringInt32 (opapp / (int32 42) (int32 6)))))
                   (do (apply putStr (string "max 3 7 = ")))
                   (do
                      (apply
                         putStrLn
                         (apply
                            toStringInt32
                            (apply (apply max (int32 3)) (int32 7)))))
                   (do (apply putStr (string "min 3 7 = ")))
                   (do
                      (apply
                         putStrLn
                         (apply
                            toStringInt32
                            (apply (apply min (int32 3)) (int32 7)))))
