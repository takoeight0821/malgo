(module
   "test/testcases/malgo/ArithInt32.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (infix left 6 +)
      (def + (fn ((clause (x y) (seq (do (apply (apply addInt32 x) y)))))))
      (infix left 6 -)
      (def - (fn ((clause (x y) (seq (do (apply (apply subInt32 x) y)))))))
      (infix left 7 *)
      (def * (fn ((clause (x y) (seq (do (apply (apply mulInt32 x) y)))))))
      (infix left 7 /)
      (def / (fn ((clause (x y) (seq (do (apply (apply divInt32 x) y)))))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (do (apply putStr (string "3 + 4 = ")))
