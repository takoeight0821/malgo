(module
   "test/testcases/malgo/CodataE2E.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (type Pair (a b) (record (fst a) (snd b)))
      (def
         mkPair
         (codata
            ((project (apply (apply # x) y) "fst") x)
            ((project (apply (apply # x) y) "snd") y)))
      (type Stream (a) (record (head a) (tail (app Stream (a)))))
      (def
         nats
         (codata
            ((project (apply # n) "head") n)
            ((project (apply # n) "tail")
               (apply nats (apply (apply addInt32 n) (int32 1))))))
      (def
         constStream
         (codata
            ((project (apply # x) "head") x)
            ((project (apply # x) "tail") (apply constStream x))))
      (def
         streamZipWith
         (codata
            ((project (apply (apply (apply # f) xs) ys) "head")
               (apply (apply f (project xs "head")) (project ys "head")))
            ((project (apply (apply (apply # f) xs) ys) "tail")
               (apply
                  (apply (apply streamZipWith f) (project xs "tail"))
                  (project ys "tail")))))
      (def
         fib
         (codata
            ((project # "head") (int32 1))
            ((project (project # "tail") "head") (int32 1))
            ((project (project # "tail") "tail")
               (apply
                  (apply (apply streamZipWith addInt32) fib)
                  (project fib "tail")))))
      (def
         drop2
         (fn ((clause (xs) (seq (do (project (project xs "tail") "tail")))))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (let p (apply (apply mkPair (int32 10)) (int32 20)))
                   (do
                      (apply printString (apply toStringInt32 (project p "fst"))))
                   (do (apply printString (string ",")))
                   (do
                      (apply printString (apply toStringInt32 (project p "snd"))))
                   (do (apply printString (string ";")))
                   (do
                      (apply
                         printString
                         (apply
                            toStringInt32
                            (project
                               (project
                                  (project
                                     (project (apply nats (int32 0)) "tail")
                                     "tail")
                                  "tail")
                               "head"))))
                   (do (apply printString (string ";")))
                   (do
                      (apply
                         printString
                         (apply
                            toStringInt32
                            (project
                               (project
                                  (project (apply constStream (int32 99)) "tail")
                                  "tail")
                               "head"))))
                   (do (apply printString (string ";")))
                   (do
                      (apply
                         printString
                         (apply
                            toStringInt32
                            (project
                               (project
                                  (project
                                     (project
                                        (project (project fib "tail") "tail")
                                        "tail")
                                     "tail")
                                  "tail")
                               "head"))))
                   (do (apply printString (string ";")))
                   (do
                      (apply
                         printString
                         (apply
                            toStringInt32
                            (project
                               (apply
                                  drop2
                                  (apply
                                     (apply
                                        (apply streamZipWith addInt32)
                                        (apply nats (int32 3)))
                                     (apply constStream (int32 10))))
                               "head")))))))))))