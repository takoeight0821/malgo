(module
   "test/testcases/malgo/InlineFunction.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (infix neutral 4 <=)
      (def <= (fn ((clause (x y) (seq (do (apply (apply leInt32 x) y)))))))
      (infix left 6 +)
      (def + (fn ((clause (x y) (seq (do (apply (apply addInt32 x) y)))))))
      (infix left 6 -)
      (def - (fn ((clause (x y) (seq (do (apply (apply subInt32 x) y)))))))
      (def fix (fn ((clause (f x) (seq (do (apply (apply f (apply fix f)) x)))))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (let
                      fib
                      (apply
                         fix
                         (fn
                            ((clause
                                (f n)
                                (seq
                                   (do
                                      (apply
                                         (apply
                                            (apply if (opapp <= n (int32 1)))
                                            (fn
                                               ((clause (_) (seq (do (int32 1)))))))
                                         (fn
                                            ((clause
                                                (_)
                                                (seq
                                                   (do
                                                      (opapp
                                                         +
                                                         (apply
                                                            f
                                                            (opapp - n (int32 1)))
                                                         (apply
                                                            f
                                                            (opapp - n (int32 2)))))))))))))))))
                   (do
                      (opapp
                         |>
                         (opapp |> (apply fib (int32 5)) toStringInt32)
                         putStrLn)))))))))