(module
   "test/testcases/malgo/LabelGoto.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (def
         printI64
         (fn
            ((clause (x) (seq (do (apply printString# (apply toStringInt64# x))))))))
      (def
         captureContinuationShape
         (fn ((clause (x) (seq (do (label k (goto x k))))))))
      (def
         nestedNonLocalShape
         (fn
            ((clause
                (x)
                (seq
                   (do (label exit (parens (label inner (parens (goto x exit)))))))))))
      (def
         viaFunctionGoto
         (fn ((clause (x) (seq (do (goto x (fn ((clause (y) (seq (do y))))))))))))
      (def passThroughLabel (fn ((clause (x) (seq (do (label k x)))))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (do (apply printI64 (apply passThroughLabel (int64 6))))
                   (do (apply printI64 (apply viaFunctionGoto (int64 7))))
                   (do (apply printI64 (label k (int64 8)))))))))))