(module
   "test/testcases/malgo/LetPattern.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (data Pair (a b) ((Pair (a b))))
      (def mkRec (fn ((clause (a b) (seq (do (record (fst a) (snd b))))))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (let
                      (record (fst x) (snd y))
                      (apply (apply mkRec (string "hello")) (string "world")))
                   (let (con Pair (p q)) (apply (apply Pair x) y))
                   (let _ (apply putStrLn p))
                   (do (apply putStrLn q)))))))))