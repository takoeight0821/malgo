(module
   "test/testcases/malgo/RowPoly.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (sig getX (-> (record (x Int64#) (row r)) Int64#))
      (def getX (fn ((clause (rec) (seq (do (project rec "x")))))))
      (sig sumXY (-> (record (x Int64#) (y Int64#) (row r)) Int64#))
      (def
         sumXY
         (fn
            ((clause
                (rec)
                (seq
                   (do
                      (apply
                         (apply addInt64# (project rec "x"))
                         (project rec "y"))))))))
      (data Option (a) ((Some (a)) (None ())))
      (sig handleSome (-> (variant (Some Int64#) (row r)) Int64#))
      (def handleSome (fn ((clause ((con Some (x))) (seq (do x))))))
      (sig
         handleOption
         (-> Int64# (-> (variant (Some Int64#) (None) (row r)) Int64#)))
      (def
         handleOption
         (fn
            ((clause (fallback (con Some (x))) (seq (do x)))
               (clause (fallback None) (seq (do fallback))))))
      (sig wideRecord (record (x Int64#) (y Int64#)))
      (def wideRecord (record (x (int64 20)) (y (int64 99))))
      (sig someOrNone (variant (Some Int64#) (None)))
      (def someOrNone (apply Some (int64 30)))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (let fromNarrowRecord (apply getX (record (x (int64 10)))))
                   (let fromWideRecord (apply getX wideRecord))
                   (let
                      fromWiderRecord
                      (apply
                         sumXY
                         (record (x (int64 1)) (y (int64 2)) (z (int64 3)))))
                   (let fromClosedVariant (apply handleSome someOrNone))
                   (let
                      fromOpenVariant
                      (apply (apply handleOption (int64 7)) someOrNone))
                   (let
                      fallbackFromNone
                      (apply (apply handleOption (int64 7)) None))
                   (let
                      total
                      (apply
                         (apply addInt64# fromNarrowRecord)
                         (apply
                            (apply addInt64# fromWideRecord)
                            (apply
                               (apply addInt64# fromWiderRecord)
                               (apply
                                  (apply addInt64# fromClosedVariant)
                                  (apply
                                     (apply addInt64# fromOpenVariant)
                                     fallbackFromNone))))))
                   (do (apply printString# (apply toStringInt64# total))))))))))