(module
   "test/testcases/malgo/Seq.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (def
         executeWhenLoaded
         (seq
            (let x (int32 1))
            (let y (int32 2))
            (do
               (apply
                  printString
                  (apply toStringInt32 (apply (apply addInt32 x) y))))
            (do (apply (apply addInt32 x) y))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (do
                      (apply printString (apply toStringInt32 executeWhenLoaded))))))))))