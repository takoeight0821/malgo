(module
   "test/testcases/malgo/StringOps.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (infix right 6 <>)
      (sig <> (-> String (-> String String)))
      (def <> appendString)
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (let str (string "Hello, World!"))
                   (do (apply putStr (string "string: ")))
                   (do (apply putStrLn str))
                   (do (apply putStr (string "length: ")))
                   (do
                      (apply
                         putStrLn
                         (apply toStringInt64 (apply lengthString str))))
                   (do (apply putStr (string "charAt(0): ")))
                   (do (apply printChar (apply (apply atString (int64 0)) str)))
                   (do (apply newline (tuple)))
                   (do (apply putStr (string "substring(0,5): ")))
                   (do
                      (apply
                         putStrLn
                         (apply (apply (apply substring str) (int64 0)) (int64 5))))
                   (do (apply putStr (string "concat: ")))
                   (do
                      (apply
                         putStrLn
                         (opapp
                            <>
                            (opapp
                               <>
                               (opapp
                                  <>
                                  (opapp <> (string "foo") (string "-"))
                                  (string "bar"))
                               (string "-"))
                            (string "baz"))))
                   (do (apply putStr (string "consString: ")))
                   (do
                      (apply
                         putStrLn
                         (apply
                            (apply consString (apply Char# (char 'X')))
                            (string "YZ")))))))))))