(module
   "test/testcases/malgo/StringPattern.mlg"
   ((import "runtime/malgo/Builtin.mlg" all)
      (import "runtime/malgo/Prelude.mlg" all)
      (def
         classify
         (fn
            ((clause ((boxed (string "red"))) (seq (do (string "stop"))))
               (clause ((boxed (string "green"))) (seq (do (string "go"))))
               (clause ((boxed (string "amber"))) (seq (do (string "slow"))))
               (clause (_) (seq (do (string "unknown")))))))
      (def
         main
         (fn
            ((clause
                (_)
                (seq
                   (let _ (apply putStrLn (apply classify (string "red"))))
                   (let _ (apply putStrLn (apply classify (string "green"))))
                   (let
                      _
                      (apply
                         putStrLn
                         (apply
                            classify
                            (apply
                               (apply appendString (string "am"))
                               (string "ber")))))
                   (do (apply putStrLn (apply classify (string "blue")))))))))))