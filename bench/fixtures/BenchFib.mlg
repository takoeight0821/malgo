module {..} = import "../../runtime/malgo/Builtin.mlg"
module {..} = import "../../runtime/malgo/Prelude.mlg"

-- A CPU-bound benchmark fixture for `bench/lean-vs-haskell.sh`: naive
-- recursive fibonacci, deliberately un-memoized so it does real work (the
-- example under `examples/malgo/Fib.mlg` only computes `fib 5`, too small
-- to produce a stable wall-clock difference between implementations).
--
-- `n = 15` is kept as the throughput baseline: it is the value every
-- lean-vs-haskell measurement so far has used, so changing it would break
-- comparability with `bench/lean-vs-haskell.md`. It used to be a hard
-- ceiling — `fib 16` and up SIGSEGV'd when compiled via the Zig backend
-- (issue #360; the earlier comment here said the threshold was 18/20, which
-- was wrong) — but the `rt.run` trampoline removed that limit entirely. See
-- `BenchFibDeep.mlg` for the fixture that exercises the depth this one
-- deliberately avoids.

infix 4 (<=)
def (<=) = { x y -> leInt32 x y }

infixl 6 (+)
def (+) = { x y -> addInt32 x y }

infixl 6 (-)
def (-) = { x y -> subInt32 x y }

def fib = { n ->
  if (n <= 1)
    { n }
    { fib (n - 1) + fib (n - 2) }
}

def main = {
  fib 15 |> toStringInt32 |> putStrLn
}
