module {..} = import "../../runtime/malgo/Builtin.mlg"
module {..} = import "../../runtime/malgo/Prelude.mlg"

infix 4 (==)
def (==) = { x y -> eqInt32 x y }

infixl 6 (+)
def (+) = { x y -> addInt32 x y }

infixl 7 (%)
def (%) = { x y -> modInt32 x y }

def fizzbuzz : Int32 -> String
def fizzbuzz = { n ->
  if (n % 15 == 0)
    { "FizzBuzz" }
    { if (n % 3 == 0)
        { "Fizz" }
        { if (n % 5 == 0)
            { "Buzz" }
            { toStringInt32 n }
        }
    }
}

def loop : Int32 -> Int32 -> ()
def loop = { i limit ->
  if (gtInt32 i limit)
    { () }
    { putStrLn (fizzbuzz i);
      loop (i + 1) limit
    }
}

def main = {
  loop 1 20
}
