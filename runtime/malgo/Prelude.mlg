module {..} = import Builtin

-- identity function
def identity : a -> a
def identity = { x -> x }

-- return `a` for all inputs
def const : a -> b -> a
def const = { a _ -> a }

-- reverse apply function
-- use as pattern match expression
def case : a -> (a -> b) -> b
def case = { x f -> f x }

-- Tuple functions
def fst : (a, b) -> a
def fst = { {a, b} -> a }

def snd : (a, b) -> b
def snd = { {a, b} -> b }

-- optional value
data Maybe a = Nothing | Just a

-- Return the first value if present, otherwise the fallback. The fallback is a
-- thunk, so it is evaluated only when the first value is Nothing.
def orElse : Maybe a -> {Maybe a} -> Maybe a
def orElse = {
  (Just v) _ -> Just v,
  Nothing  k -> k ()
}

-- Look up an environment variable (see Builtin.mlg's `malgo_has_env`/
-- `malgo_get_env` for why this is two primitives, checked separately,
-- rather than one that treats "" as absent).
--
-- Uses `eqInt32` (a boxed, Bool-returning Builtin.mlg function), not the raw
-- `isTrue#` helper, even though both are equally valid at the type level:
-- the self-hosted compiler's (runtime/malgo/compiler/) cross-module name
-- resolution fails on a direct `isTrue#` reference from Prelude.mlg with
-- "undefined: isTrue#", while every other numeric comparison Prelude.mlg
-- does goes through a Builtin.mlg wrapper like `leInt32`/`gtInt32` and never
-- names `isTrue#` directly -- this follows that existing, working pattern.
def getEnv : String -> Maybe String
def getEnv = { (String# name) ->
  if (eqInt32 (Int32# (hasEnv# name)) (Int32# 1#))
    { Just (String# (getEnvRaw# name)) }
    { Nothing }
}

-- list
data List a = Nil | Cons a (List a)

def head : List a -> a
def head =
  { (Cons x _) -> x,
    _ -> exitFailure (),
  }

def tail : List a -> List a
def tail =
  { (Cons _ xs) -> xs,
    _ -> exitFailure (),
  }

-- fold left
def foldl : (a -> b -> a) -> a -> List b -> a
def foldl =
  { _ z Nil -> z,
    f z (Cons x xs) -> foldl f (f z x) xs,
  }

-- map function over a list
def mapList : (a -> b) -> List a -> List b
def mapList =
  { _ Nil -> Nil,
    f (Cons x xs) -> Cons (f x) (mapList f xs),
  }

-- Whether `s` contains an embedded NUL byte. Nothing else in this codebase
-- needs this, but `joinWithNul`/`runProcess` do: NUL is the one byte their
-- wire encoding can't represent inside an element (see `joinWithNul`
-- below), so a caller passing one through needs a loud failure here, not
-- a silently mis-split argument list on the decode side.
def containsNul : String -> Bool
def containsNul = { s -> containsNulAt s 0i64 (lengthString s) }

def containsNulAt : String -> Int64 -> Int64 -> Bool
def containsNulAt = { s i len ->
  if (geInt64 i len)
    { False }
    { if (eqChar (atString i s) (Char# '\0'#))
        { True }
        { containsNulAt s (addInt64 i 1i64) len }
    }
}

-- Print `msg` to stderr and exit 1. `panic` (Builtin.mlg) would be the
-- obvious choice for an invariant violation like this, but it's only
-- implemented on the Zig and Scheme backends today -- unimplemented on
-- the interpreter (`malgo_panic` throws "Primitive malgo_panic is not
-- implemented"), so a guard meant to fire identically everywhere can't
-- use it yet. Tracked as malgo#426; not this fix's scope.
def failLoudly : String -> a
def failLoudly = { msg -> let _ = printStderr msg; exitWith 1i32 }

-- Encode a list of strings as each element followed by a NUL terminator
-- (see Builtin.mlg's malgo_run_process for why NUL rather than newline).
-- A *trailing* terminator per element, not a separator *between* elements,
-- so the empty list ("") and a one-element list of the empty string ("\0")
-- encode differently -- joining with a separator can't tell those apart.
def joinWithNul : List String -> String
def joinWithNul =
  { Nil -> "",
    (Cons s rest) ->
      if (containsNul s)
        { failLoudly "runProcess: an argument contains an embedded NUL byte, which the NUL-terminated wire encoding cannot represent" }
        { appendString s (appendString "\0" (joinWithNul rest)) },
  }

-- Run `cmd` with `args`, returning (exit code, stdout, stderr). Unboxes
-- `joinWithNul`'s result through this helper's own parameter pattern
-- (matching every other boxed-argument wrapper in this file) rather than a
-- `case`/`let`, since `String` has exactly one constructor and the lint
-- flags that kind of match as irrefutable.
def runProcessBoxed# : String# -> String -> (Int32, String, String)
def runProcessBoxed# = { cmd (String# argsBlob) -> runProcess# cmd argsBlob }

def runProcess : String -> List String -> (Int32, String, String)
def runProcess = { (String# cmd) args ->
  if (containsNul (String# cmd))
    { failLoudly "runProcess: cmd contains an embedded NUL byte" }
    { runProcessBoxed# cmd (joinWithNul args) }
}

-- convert a list of character to a string
def listToString : List Char -> String
def listToString =
  { Nil -> "",
    (Cons c cs) -> consString c (listToString cs)
  }

-- get the first character of string
def headString : String -> Maybe Char
def headString = { str ->
  if (eqString str "")
    { Nothing }
    { Just (atString 0i64 str) }
}

-- trim the first character of string
def tailString : String -> String
def tailString = { str ->
  if (eqString str "")
    { str }
    { substring str 1i64 (lengthString str) }
}

-- return the longest prefix of `str` of that satisfy `pred`
def takeWhileString = { pred str ->
  case (headString str) {
    Nothing -> str,
    (Just c) ->
      if (pred c)
        { consString c (takeWhileString pred (tailString str)) }
        { "" }
  }
}

-- return the suffix remains after `takeWhileString pred str`
def dropWhileString = { pred str ->
  case (headString str) {
    Nothing -> str,
    (Just c) ->
      if (pred c)
        { dropWhileString pred (tailString str) }
        { str }
  }
}

def concatString : List String -> String
def concatString =
  { Nil -> "",
    (Cons x xs) -> appendString x (concatString xs)
  }

def punctuate : a -> List a -> List a
def punctuate =
  { _ Nil -> Nil,
    _ (Cons x Nil) -> Cons x Nil,
    sep (Cons x xs) -> Cons x (Cons sep (punctuate sep xs))
  }

-- check that `x` is a whitespace
def isWhiteSpace : Char -> Bool
def isWhiteSpace =
  { (Char# ' '#) -> True,
    (Char# '\n'#) -> True,
    (Char# '\r'#) -> True,
    (Char# '\t'#) -> True,
    _ -> False
  }

infixr 9 (<<)
def (<<) : (b -> c) -> (a -> b) -> (a -> c)
def (<<) = {f g -> {x -> f (g x)}}

infixl 0 (|>)
def (|>) : a -> (a -> b) -> b
def (|>) = {x f -> f x}

infixr 0 (<|)
def (<|) : (a -> b) -> a -> b
def (<|) = {f x -> f x}

def if : Bool -> {a} -> {a} -> a
def if =
  { True t _ -> t (),
    False _ f -> f (),
  }

def unless : Bool -> a -> {a} -> a
def unless = { c tValue f -> if c {tValue} f }

-- multiway if
def cond : List (Bool, {a}) -> a
def cond =
  { Nil -> panic "no branch",
    (Cons (True, x) _) -> x (),
    (Cons (False, _) xs) -> cond xs
  }

def putStr : String -> ()
def putStr = { str -> printString str }

def putStrLn : String -> ()
def putStrLn = { str ->
  printString str;
  newline ()
}

def printInt32 : Int32 -> ()
def printInt32 = { i -> printString (toStringInt32 i) }

def printInt64 : Int64 -> ()
def printInt64 = { i -> printString (toStringInt64 i) }

def print : a -> ()
def print = { x -> malgo_print x }

-- List utilities

def null : List a -> Bool
def null =
  { Nil -> True,
    _ -> False
  }

def length : List a -> Int32
def length =
  { Nil -> 0,
    (Cons _ xs) -> addInt32 1 (length xs)
  }

def reverse : List a -> List a
def reverse = { xs -> reverseAcc xs Nil }

def reverseAcc : List a -> List a -> List a
def reverseAcc =
  { Nil acc -> acc,
    (Cons x xs) acc -> reverseAcc xs (Cons x acc)
  }

def filter : (a -> Bool) -> List a -> List a
def filter =
  { _ Nil -> Nil,
    pred (Cons x xs) ->
      if (pred x)
        { Cons x (filter pred xs) }
        { filter pred xs }
  }

def zip : List a -> List b -> List (a, b)
def zip =
  { Nil _ -> Nil,
    _ Nil -> Nil,
    (Cons x xs) (Cons y ys) -> Cons((x, y), zip xs ys)
  }

def zipWith : (a -> b -> c) -> List a -> List b -> List c
def zipWith =
  { _ Nil _ -> Nil,
    _ _ Nil -> Nil,
    f (Cons x xs) (Cons y ys) -> Cons (f x y) (zipWith f xs ys)
  }

def replicate : Int32 -> a -> List a
def replicate = { n x ->
  if (leInt32 n 0)
    { Nil }
    { Cons x (replicate (subInt32 n 1) x) }
}

def any : (a -> Bool) -> List a -> Bool
def any =
  { _ Nil -> False,
    pred (Cons x xs) ->
      if (pred x) { True } { any pred xs }
  }

def all : (a -> Bool) -> List a -> Bool
def all =
  { _ Nil -> True,
    pred (Cons x xs) ->
      if (pred x) { all pred xs } { False }
  }

def foldr : (a -> b -> b) -> b -> List a -> b
def foldr =
  { _ z Nil -> z,
    f z (Cons x xs) -> f x (foldr f z xs)
  }

def append : List a -> List a -> List a
def append =
  { Nil ys -> ys,
    (Cons x xs) ys -> Cons x (append xs ys)
  }

def concatList : List (List a) -> List a
def concatList =
  { Nil -> Nil,
    (Cons xs xss) -> append xs (concatList xss)
  }

def take : Int32 -> List a -> List a
def take = { n xs ->
  if (leInt32 n 0)
    { Nil }
    { case xs {
        Nil -> Nil,
        (Cons x rest) -> Cons x (take (subInt32 n 1) rest)
      }
    }
}

def drop : Int32 -> List a -> List a
def drop = { n xs ->
  if (leInt32 n 0)
    { xs }
    { case xs {
        Nil -> Nil,
        (Cons _ rest) -> drop (subInt32 n 1) rest
      }
    }
}

-- Numeric utilities

def abs : Int32 -> Int32
def abs = { n ->
  if (ltInt32 n 0)
    { negInt32 n }
    { n }
}

def max : Int32 -> Int32 -> Int32
def max = { x y ->
  if (gtInt32 x y) { x } { y }
}

def min : Int32 -> Int32 -> Int32
def min = { x y ->
  if (ltInt32 x y) { x } { y }
}
