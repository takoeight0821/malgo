data Nat = Zero | Succ Nat

def toNat = { n ->
  if (eqInt32 n 0i32) { _ -> Zero } { _ -> Succ (toNat (subInt32 n 1i32)) }
}

def fromNat = { nat ->
  case nat {
    Zero -> 0i32,
    (Succ n) -> addInt32 1i32 (fromNat n)
  }
}

def addNat = { a b ->
  case a {
    Zero -> b,
    (Succ n) -> Succ (addNat n b)
  }
}

def main = { _ ->
  let three = toNat 3i32;
  let four = toNat 4i32;
  let seven = addNat three four;
  fromNat seven
}
