  }}}}}}}}}}}}}}}}}}
}

-- ─── Base environment with built-ins ─────────────────────────────────────────

def addBuiltin : Env -> String -> Env
def addBuiltin = { env name ->
  let ar = foreignArity name;
  envExtend name (VBuiltin(name, ar, Nil)) env
}

def builtinNames : List String
def builtinNames = append coreBuiltinNames extraBuiltinNames

def coreBuiltinNames : List String
def coreBuiltinNames =
  Cons "appendString" (Cons "eqString" (Cons "printString" (Cons "printChar" (
  Cons "addInt32" (Cons "subInt32" (Cons "mulInt32" (Cons "divInt32" (
  Cons "modInt32" (Cons "eqInt32" (Cons "ltInt32" (Cons "leInt32" (Cons "gtInt32" (Cons "toStringInt32" (
  Cons "toStringInt64" (Cons "lengthString" (Cons "atString" (Cons "consString" (
  Cons "substring" (Cons "reverseString" (Cons "isDigit" (Cons "isUpper" (
  Cons "isLower" (Cons "isAlphanum" (Cons "ordChar" (Cons "chrInt32" (
  Cons "if" (Cons "case" Nil
  )))))))))))))))))))))))))))

def extraBuiltinNames : List String
def extraBuiltinNames = append ioBuiltinNames (append int64BuiltinNames (append rawInt32BuiltinNames (append stringConvBuiltinNames (append wrapperBuiltinNames preludeBuiltinNames))))

def ioBuiltinNames : List String
def ioBuiltinNames =
  Cons "putStr" (Cons "putStrLn" (
  Cons "printString#" (Cons "malgo_print_string" (Cons "newline" (Cons "malgo_newline" (
  Cons "printInt32" (Cons "printInt64" (Cons "exitFailure" (Cons "malgo_exit_failure" (Cons "|>" (Cons "<|" Nil
  )))))))))))

def int64BuiltinNames : List String
def int64BuiltinNames =
  Cons "addInt64" (Cons "subInt64" (Cons "mulInt64" (Cons "divInt64" (
  Cons "eqInt64" (Cons "ltInt64" (Cons "leInt64" (
  Cons "gtInt64" (Cons "addInt64#" (Cons "subInt64#" (Cons "mulInt64#" (Cons "divInt64#" (
  Cons "malgo_add_int64_t" (Cons "malgo_sub_int64_t" (Cons "malgo_mul_int64_t" (Cons "malgo_div_int64_t" (
  Nil
  ))))))))))))))))

def rawInt32BuiltinNames : List String
def rawInt32BuiltinNames =
  Cons "malgo_add_int32_t" (Cons "malgo_sub_int32_t" (Cons "malgo_mul_int32_t" (Cons "malgo_div_int32_t" (
  Cons "malgo_eq_int32_t" (Cons "malgo_lt_int32_t" (Cons "malgo_le_int32_t" Nil
  ))))))

def stringConvBuiltinNames : List String
def stringConvBuiltinNames =
  Cons "toStringInt64#" (Cons "malgo_int64_t_to_string" (Cons "toStringInt32#" (Cons "malgo_int32_t_to_string" (Cons "toStringDouble#" (
  Cons "parseIntString32" (Cons "parseIntString64" Nil
  ))))))

def wrapperBuiltinNames : List String
def wrapperBuiltinNames =
  Cons "String#" (Cons "Int32#" (Cons "Int64#" (Cons "Char#" (Cons "Float#" (Cons "Double#" Nil
  )))))

def preludeBuiltinNames : List String
def preludeBuiltinNames =
  Cons "max" (Cons "min" (Cons "abs" (Cons "const" (Cons "getContents" (Cons "print" (Cons "malgo_print" (Cons "toStringDouble" (Cons "negInt32" (
  Cons "addDouble#" (Cons "subDouble#" (Cons "mulDouble#" (Cons "goto" (
  Cons "eqChar" (Cons "geInt32" (Cons "neInt32" (Cons "neInt64" (Cons "geInt64" (Cons "negInt64" (Cons "modInt64" (
  Cons "exitSuccess" (Cons "malgo_exit_success" (Cons "malgo_panic" (Cons "malgo_unsafe_cast" (
  Cons "getRawArgs" (Cons "readFile" (Cons "charToString" (Cons "modInt64#" (
  Cons "malgo_mod_int64_t" (Cons "malgo_neg_int64_t" (Cons "malgo_mod_int32_t" (Cons "malgo_neg_int32_t" (
  Cons "malgo_gt_int32_t" (Cons "malgo_ge_int32_t" (Cons "malgo_ne_int32_t" (
  Cons "malgo_eq_int64_t" (Cons "malgo_lt_int64_t" (Cons "malgo_le_int64_t" (
  Cons "malgo_gt_int64_t" (Cons "malgo_ge_int64_t" (Cons "malgo_ne_int64_t" Nil
  ))))))))))))))))))))))))))))))))))))))))
def makeBaseEnv : Env
def makeBaseEnv = addBaseConstructors (foldl addBuiltin EnvEmpty builtinNames)

def addBaseConstructors : Env -> Env
def addBaseConstructors = { env ->
  envExtend "Cons" (VCon("Cons", 2i32, Nil)) (
  envExtend "Nil" (VCon("Nil", 0i32, Nil)) (
  envExtend "Just" (VCon("Just", 1i32, Nil)) (
  envExtend "Nothing" (VCon("Nothing", 0i32, Nil)) (
  envExtend "True" (VCon("True", 0i32, Nil)) (
  envExtend "False" (VCon("False", 0i32, Nil)) env)))))
}

-- ─── Entry points ─────────────────────────────────────────────────────────────

def evalModuleWithState : Env -> CompilerState -> Module -> Either String {state: CompilerState, env: Env}
def evalModuleWithState = { baseEnv state (Module decls) -> evalDecls baseEnv state decls }

def evalModule : Env -> Module -> Either String Env
def evalModule = { baseEnv modl ->
  bindRight (evalModuleWithState baseEnv emptyState modl) { {state = _, env = moduleEnv} ->
    Right moduleEnv
  }
}

def evalModuleAt : Env -> String -> Module -> Either String Env
def evalModuleAt = { baseEnv sourcePath modl ->
  let initialState =
    if (eqString sourcePath "")
      { emptyState }
      { let normalizedPath = normalizePath sourcePath;
        CompilerState(
          Cons (ModuleCacheEntry(normalizedPath, Loading)) Nil,
          Cons normalizedPath Nil,
          dirname normalizedPath
        )
      };
  bindRight (evalModuleWithState baseEnv initialState modl) { {state = _, env = moduleEnv} ->
    Right moduleEnv
  }
}

def runMain : Env -> Either String Value
def runMain = { gEnv ->
  case (envLookup "main" gEnv) {
    Nothing      -> Left "no main defined",
    (Just mainF) ->
      bindRight (forceValue gEnv mainF) { forcedMain ->
        apply gEnv forcedMain VUnit
      }
  }
}

