def foreignArity9 : String -> Int32
def foreignArity9 = { name ->
  if (eqString name "malgo_unsafe_cast") { 1i32 } {
  if (eqString name "getRawArgs") { 1i32 } {
  if (eqString name "readFile") { 1i32 } {
  if (eqString name "charToString") { 1i32 } {
  if (eqString name "modInt64#") { 2i32 } {
  if (eqString name "malgo_mod_int64_t") { 2i32 } {
