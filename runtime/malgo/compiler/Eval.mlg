  if (eqString name "malgo_int32_t_to_string") { 1i32 } {
  if (eqString name "toStringDouble#")         { 1i32 } {
  if (isWrapperName name)                       { 1i32 } {
    foreignArity7 name
  }}}}}}}}}}}}}
}

def foreignArity7 : String -> Int32
def foreignArity7 = { name ->
  if (eqString name "max") { 2i32 } {
