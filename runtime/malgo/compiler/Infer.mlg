module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"
module {..} = import "../../../runtime/malgo/Either.mlg"
module {..} = import "../../../runtime/malgo/compiler/Type.mlg"

-- ──────────────────────────────────────────────────────────────────────
-- Type inference constraints
-- ──────────────────────────────────────────────────────────────────────

data Constraint
  = CtEq(Ty, Ty)
  | CtField(Ty, String, Ty)

-- Type inference state (fresh variable counter + substitution)
data InferState = InferState(Int32, TySub)

def freshTyVar : InferState -> {state: InferState, var: TyVar}
def freshTyVar = { (InferState count sub) ->
  let name = appendString "a" (toStringInt32 count);
  {state = InferState(addInt32 count 1i32, sub), var = TyVar name}
}

def inferState0 : InferState
def inferState0 = InferState(0i32, emptySub)

def currentSub : InferState -> TySub
def currentSub = { (InferState _ sub) -> sub }

-- ──────────────────────────────────────────────────────────────────────
-- Unification (Robinson's algorithm)
-- ──────────────────────────────────────────────────────────────────────

def unify : TySub -> Ty -> Ty -> Either String TySub
def unify = { sub t1 t2 ->
  let t1n = applySubTy sub t1;
  let t2n = applySubTy sub t2;
  unifyNF sub t1n t2n
}

def unifyNF : TySub -> Ty -> Ty -> Either String TySub
def unifyNF = { sub t1 t2 ->
  case t1 {
    (TVar v1) ->
      case t2 {
        (TVar v2) ->
          if (eqTyVar v1 v2)
            { Right sub }
            { Right (composeSub (singleSub v1 t2) sub) },
        _ ->
          if (tyVarMember v1 (freeTyVars t2))
            { Left (appendString "infinite type: " (appendString (showTyVar v1) (appendString " = " (showTy t2)))) }
            { Right (composeSub (singleSub v1 t2) sub) }
      },
    _ ->
      case t2 {
        (TVar v2) ->
          if (tyVarMember v2 (freeTyVars t1))
            { Left (appendString "infinite type: " (appendString (showTyVar v2) (appendString " = " (showTy t1)))) }
            { Right (composeSub (singleSub v2 t1) sub) },
        _ -> unifyStructural sub t1 t2
      }
  }
}

def unifyStructural : TySub -> Ty -> Ty -> Either String TySub
def unifyStructural = { sub t1 t2 ->
  case t1 {
    (TCon c1) ->
      case t2 {
        (TCon c2) ->
          if (eqString (showTyCon c1) (showTyCon c2))
            { Right sub }
            { Left (appendString "type mismatch: " (appendString (showTy t1) (appendString " vs " (showTy t2)))) },
        _ -> Left (appendString "type mismatch: " (appendString (showTy t1) (appendString " vs " (showTy t2))))
      },
    (TApp a1 b1) ->
      case t2 {
        (TApp a2 b2) ->
          bindRight (unify sub a1 a2) { sub2 -> unify sub2 b1 b2 },
        _ -> Left (appendString "type mismatch: " (appendString (showTy t1) (appendString " vs " (showTy t2))))
      },
    (TArr a1 b1) ->
      case t2 {
        (TArr a2 b2) ->
          bindRight (unify sub a1 a2) { sub2 -> unify sub2 b1 b2 },
        _ -> Left (appendString "type mismatch: " (appendString (showTy t1) (appendString " vs " (showTy t2))))
      },
    (TTuple ts1) ->
      case t2 {
        (TTuple ts2) -> unifyList sub ts1 ts2,
        _ -> Left (appendString "type mismatch: " (appendString (showTy t1) (appendString " vs " (showTy t2))))
      },
    TBottom -> Right sub,
    _ ->
      case t2 {
        TBottom -> Right sub,
        _ -> Left (appendString "type mismatch: " (appendString (showTy t1) (appendString " vs " (showTy t2))))
      }
  }
}

def unifyList : TySub -> List Ty -> List Ty -> Either String TySub
def unifyList = { sub ts1 ts2 ->
  case ts1 {
    Nil ->
      case ts2 {
        Nil -> Right sub,
        _ -> Left "arity mismatch in unification"
      },
    (Cons t1 rest1) ->
      case ts2 {
        Nil -> Left "arity mismatch in unification",
        (Cons t2 rest2) ->
          bindRight (unify sub t1 t2) { sub2 -> unifyList sub2 rest1 rest2 }
      }
  }
}

-- ──────────────────────────────────────────────────────────────────────
-- Solve a list of constraints
-- ──────────────────────────────────────────────────────────────────────

def solveConstraints : TySub -> List Constraint -> Either String TySub
def solveConstraints = { sub constraints ->
  case constraints {
    Nil -> Right sub,
    (Cons c rest) ->
      bindRight (solveConstraint sub c) { sub2 ->
        solveConstraints sub2 rest
      }
  }
}

def solveConstraint : TySub -> Constraint -> Either String TySub
def solveConstraint = { sub c ->
  case c {
    (CtEq t1 t2) -> unify sub t1 t2,
    (CtField _ _ _) ->
      -- TODO: proper row unification
      Right sub
  }
}

-- ──────────────────────────────────────────────────────────────────────
-- Type environment
-- ──────────────────────────────────────────────────────────────────────

data TyEnv = TyEnv(List TyEnvEntry)
data TyEnvEntry = TyEnvEntry(String, Scheme)

def emptyTyEnv : TyEnv
def emptyTyEnv = TyEnv Nil

def tyEnvExtend : String -> Scheme -> TyEnv -> TyEnv
def tyEnvExtend = { name scheme (TyEnv entries) ->
  TyEnv (Cons (TyEnvEntry(name, scheme)) entries)
}

def tyEnvLookup : String -> TyEnv -> Maybe Scheme
def tyEnvLookup = { name (TyEnv entries) ->
  case entries {
    Nil -> Nothing,
    (Cons (TyEnvEntry n s) rest) ->
      if (eqString name n) { Just s } { tyEnvLookup name (TyEnv rest) }
  }
}

-- Instantiate a scheme with fresh type variables
def instantiate : InferState -> Scheme -> {state: InferState, ty: Ty}
def instantiate = { istate (Scheme vars body) ->
  case vars {
    Nil -> {state = istate, ty = body},
    (Cons v rest) ->
      let fr = freshTyVar istate;
      let sub2 = singleSub v (TVar fr.var);
      let body2 = applySubTy sub2 body;
      instantiate fr.state (Scheme rest body2)
  }
}

-- Generalize: close over free vars not in env
def generalize : TyEnv -> TySub -> Ty -> Scheme
def generalize = { env sub ty ->
  let ty2 = applySubTy sub ty;
  let envVars = tyEnvFreeVars env;
  let freeVars = filter { v -> not (tyVarMember v envVars) } (freeTyVars ty2);
  Scheme(dedup freeVars, ty2)
}

def tyEnvFreeVars : TyEnv -> List TyVar
def tyEnvFreeVars = { (TyEnv entries) ->
  concatMapTy { (TyEnvEntry _ (Scheme _ ty)) -> freeTyVars ty } entries
}

def dedup : List TyVar -> List TyVar
def dedup = {
  Nil -> Nil,
  (Cons v rest) ->
    if (tyVarMember v rest)
      { dedup rest }
      { Cons v (dedup rest) }
}

def main = { _ -> putStrLn "Infer module OK" }
