module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"
module {..} = import "../../../runtime/malgo/Either.mlg"
module {..} = import "../../../runtime/malgo/compiler/Token.mlg"
module {..} = import "../../../runtime/malgo/compiler/Lexer.mlg"

def showTokenList : List Token -> String
def showTokenList = {
  Nil -> "",
  (Cons t rest) -> appendString (showToken t) (appendString " " (showTokenList rest))
}

def main = {
  let src = "def foo = { x -> x + 1 }";
  case (tokenize src) {
    (Left e) ->
      putStrLn (appendString "Error: " e),
    (Right toks) ->
      putStrLn (showTokenList toks)
  }
}
