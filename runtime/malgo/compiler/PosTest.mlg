module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"
module {..} = import "../../../runtime/malgo/Either.mlg"
module {..} = import "../../../runtime/malgo/compiler/Token.mlg"
module {..} = import "../../../runtime/malgo/compiler/Lexer.mlg"

def testSource : String
def testSource = "def foo = 42i32\ndef bar = foo"

def main = {
  case (tokenizeWithPos testSource) {
    (Left err) -> putStrLn (appendString "FAIL: lex error: " err),
    (Right toks) ->
      case toks {
        Nil -> putStrLn "FAIL: empty token list",
        (Cons (Located tok pos) _) ->
          let (SourcePos line col) = pos;
          if (eqInt64 line 1i64)
            { putStrLn "PASS: first token on line 1" }
            { putStrLn (appendString "FAIL: expected line 1, got " (toStringInt64 line)) }
      }
  }
}
