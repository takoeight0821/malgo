module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"
module {..} = import "../../../runtime/malgo/compiler/AST.mlg"

-- ──────────────────────────────────────────────────────────────────────
-- Name scoping environment
-- ──────────────────────────────────────────────────────────────────────

-- A scope maps raw names to resolved (qualified) names.
-- For this self-hosted implementation both sides are String.
data NameScope = NameScope(List ScopeEntry)

data ScopeEntry = ScopeEntry(String, String)

def emptyScope : NameScope
def emptyScope = NameScope Nil

def scopeExtend : String -> String -> NameScope -> NameScope
def scopeExtend = { name resolved (NameScope entries) ->
  NameScope (Cons (ScopeEntry name resolved) entries)
}

def scopeLookup : String -> NameScope -> Maybe String
def scopeLookup = { name (NameScope entries) ->
  case entries {
    Nil -> Nothing,
    (Cons (ScopeEntry n r) rest) ->
      if (eqString name n) { Just r } { scopeLookup name (NameScope rest) }
  }
}

-- ──────────────────────────────────────────────────────────────────────
-- Rename errors
-- ──────────────────────────────────────────────────────────────────────

data RenameError = RenameError String

def renameErrorMsg : RenameError -> String
def renameErrorMsg = { (RenameError msg) -> msg }

-- ──────────────────────────────────────────────────────────────────────
-- Helpers
-- ──────────────────────────────────────────────────────────────────────

def concatMapStr : (a -> List b) -> List a -> List b
def concatMapStr = { f xs ->
  foldl { acc x -> append acc (f x) } Nil xs
}

def listMember : String -> List String -> Bool
def listMember = { s xs ->
  case xs {
    Nil -> False,
    (Cons x rest) -> if (eqString s x) { True } { listMember s rest }
  }
}

-- ──────────────────────────────────────────────────────────────────────
-- Collect top-level names from declarations
-- ──────────────────────────────────────────────────────────────────────

def collectTopLevel : List Decl -> NameScope
def collectTopLevel = { decls -> foldl addDeclToScope emptyScope decls }

def addDeclToScope : NameScope -> Decl -> NameScope
def addDeclToScope = { scope decl ->
  case decl {
    (DeclDef name _)           -> scopeExtend name name scope,
    (DeclData _ _ cons)        -> foldl addConToScope scope cons,
    (DeclForeign name _)       -> scopeExtend name name scope,
    (DeclTypeSig _ _)          -> scope,
    (DeclTypeSynonym _ _ _)    -> scope,
    (DeclInfix _ _ _)          -> scope,
    (DeclImport _ _)           -> scope
  }
}

def addConToScope : NameScope -> ConDecl -> NameScope
def addConToScope = { scope (ConDecl name _) -> scopeExtend name name scope }

-- ──────────────────────────────────────────────────────────────────────
-- Bound variable extraction from patterns
-- ──────────────────────────────────────────────────────────────────────

def patBoundVars : Pat -> List String
def patBoundVars = { pat ->
  case pat {
    (PatVar name)    -> Cons name Nil,
    PatWild          -> Nil,
    (PatCon _ pats)  -> concatMapStr patBoundVars pats,
    (PatLit _)       -> Nil,
    (PatTuple pats)  -> concatMapStr patBoundVars pats,
    (PatRecord flds) -> concatMapStr patFieldBoundVars flds
  }
}

def patFieldBoundVars : PatField -> List String
def patFieldBoundVars = { (PatField _ pat) -> patBoundVars pat }

def coSegBoundVars : CoSeg -> List String
def coSegBoundVars = { seg ->
  case seg {
    (CoApply pats) -> concatMapStr patBoundVars pats,
    (CoField _)    -> Nil
  }
}

-- ──────────────────────────────────────────────────────────────────────
-- Check expressions for undefined names
-- ──────────────────────────────────────────────────────────────────────

def checkExpr : NameScope -> Expr -> List RenameError
def checkExpr = { scope expr ->
  case expr {
    (ExVar name) ->
      case (scopeLookup name scope) {
        (Just _) -> Nil,
        Nothing  -> Cons (RenameError (appendString "undefined name: " name)) Nil
      },
    (ExLit _)  -> Nil,
    ExUnit     -> Nil,
    (ExApp f x) ->
      append (checkExpr scope f) (checkExpr scope x),
    (ExTuple es) ->
      concatMapStr (checkExpr scope) es,
    (ExRecord flds) ->
      concatMapStr (checkExprField scope) flds,
    (ExField e _) ->
      checkExpr scope e,
    (ExLet name bindExpr body) ->
      let innerScope = scopeExtend name name scope;
      append (checkExpr scope bindExpr) (checkExpr innerScope body),
    (ExCase arms) ->
      concatMapStr (checkArm scope) arms,
    (ExCoCase arms) ->
      concatMapStr (checkCoArm scope) arms,
    -- ExArm / ExCoArm are handled via ExCase / ExCoCase above;
    -- if encountered standalone, just recurse into the body.
    (ExArm pats body) ->
      let bound = concatMapStr patBoundVars pats;
      let innerScope = foldl { sc n -> scopeExtend n n sc } scope bound;
      checkExpr innerScope body,
    (ExCoArm segs body) ->
      let bound = concatMapStr coSegBoundVars segs;
      let innerScope = foldl { sc n -> scopeExtend n n sc } scope bound;
      checkExpr innerScope body
  }
}

def checkExprField : NameScope -> ExprField -> List RenameError
def checkExprField = { scope (ExprField _ e) -> checkExpr scope e }

-- Check one case arm: ExArm(List Pat, Expr)
def checkArm : NameScope -> Expr -> List RenameError
def checkArm = { scope arm ->
  case arm {
    (ExArm pats body) ->
      let bound = concatMapStr patBoundVars pats;
      let innerScope = foldl { sc n -> scopeExtend n n sc } scope bound;
      checkExpr innerScope body,
    other -> checkExpr scope other
  }
}

-- Check one copattern arm: ExCoArm(List CoSeg, Expr)
def checkCoArm : NameScope -> Expr -> List RenameError
def checkCoArm = { scope arm ->
  case arm {
    (ExCoArm segs body) ->
      let bound = concatMapStr coSegBoundVars segs;
      let innerScope = foldl { sc n -> scopeExtend n n sc } scope bound;
      checkExpr innerScope body,
    other -> checkExpr scope other
  }
}

-- ──────────────────────────────────────────────────────────────────────
-- Check declarations and whole modules
-- ──────────────────────────────────────────────────────────────────────

def checkDecl : NameScope -> Decl -> List RenameError
def checkDecl = { scope decl ->
  case decl {
    (DeclDef _ expr)        -> checkExpr scope expr,
    (DeclData _ _ _)        -> Nil,
    (DeclForeign _ _)       -> Nil,
    (DeclTypeSig _ _)       -> Nil,
    (DeclTypeSynonym _ _ _) -> Nil,
    (DeclInfix _ _ _)       -> Nil,
    (DeclImport _ _)        -> Nil
  }
}

-- Check a module: collect top-level names first, then check each definition.
-- The supplied `prelude` scope contains names from imported modules.
def checkModule : NameScope -> Module -> List RenameError
def checkModule = { prelude (Module decls) ->
  let topScope = foldl addDeclToScope prelude decls;
  concatMapStr (checkDecl topScope) decls
}

-- ──────────────────────────────────────────────────────────────────────
-- Pretty-print errors
-- ──────────────────────────────────────────────────────────────────────

def printRenameErrors : List RenameError -> ()
def printRenameErrors = { errors ->
  case errors {
    Nil -> (),
    (Cons e rest) ->
      let _ = putStrLn (appendString "RenameError: " (renameErrorMsg e));
      printRenameErrors rest
  }
}

def main = { _ -> putStrLn "Rename module OK" }
