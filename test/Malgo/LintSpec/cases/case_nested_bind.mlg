-- `x` is bound by a nested head pattern and used only as a `case` scrutinee,
-- so the `case` arms fold into nested patterns across extra clauses. The
-- non-last plain parameter `tag` in `g` is left alone (folding it would just
-- duplicate the other parameters across every clause).
def f = { (Cons x rest) -> case x {
  Red -> rest,
  Green -> rest,
  _ -> rest
} }

def g = { tag y -> case tag {
  Red -> y,
  Green -> y
} }
