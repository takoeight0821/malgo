module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

infixl 6 (+)
def (+) = { x y -> addInt32 x y }

infixl 6 (-)
def (-) = { x y -> subInt32 x y }

infixl 7 (*)
def (*) = { x y -> mulInt32 x y }

infixl 7 (/)
def (/) = { x y -> divInt32 x y }

def main = {
  putStr "3 + 4 = ";
  putStrLn (toStringInt32 (3 + 4));

  putStr "10 - 3 = ";
  putStrLn (toStringInt32 (10 - 3));

  putStr "6 * 7 = ";
  putStrLn (toStringInt32 (6 * 7));

  putStr "42 / 6 = ";
  putStrLn (toStringInt32 (42 / 6));

  putStr "max 3 7 = ";
  putStrLn (toStringInt32 (max 3 7));

  putStr "min 3 7 = ";
  putStrLn (toStringInt32 (min 3 7));

  putStr "abs (-5) = ";
  putStrLn (toStringInt32 (abs (negInt32 5)))
}
