module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- Test bottom type (_|_) and tilde type (~T) annotations
-- These are parsed and passed through the pipeline

-- A function annotated with bottom type in a type signature
def absurd : _|_ -> a
def absurd = { x -> absurd x }

-- A function using tilde type annotation
def id_tilde : ~Int64# -> ~Int64#
def id_tilde = { x -> x }

def main = { (_) ->
  putStr (String# "bottom-tilde-ok"#)
}
