#malgo-2025
module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- Codata E2E in unified parser mode.

type Pair(a, b) = { fst: a, snd: b }

def mkPair = {
  #(x, y).fst -> x,
  #(x, y).snd -> y
}

-- 2. Infinite stream codata (recursive)
type Stream(a) = { head: a, tail: Stream(a) }

def nats = {
  #(n).head -> n,
  #(n).tail -> nats (addInt32(n, 1))
}

def constStream = {
  #(x).head -> x,
  #(x).tail -> constStream(x)
}

def streamZipWith = {
  #(f, xs, ys).head -> f(xs.head, ys.head),
  #(f, xs, ys).tail -> streamZipWith(f, xs.tail, ys.tail)
}

def fib = {
  #.head -> 1,
  #.tail.head -> 1,
  #.tail.tail -> streamZipWith(addInt32, fib, fib.tail)
}

def drop2 = { xs ->
  xs.tail.tail
}

def main = { _ ->
  let p = mkPair(10, 20);
  printString(toStringInt32(p.fst));
  printString(",");
  printString (toStringInt32 (p.snd));
  printString(";");
  printString (toStringInt32 (nats(0).tail.tail.tail.head));
  printString(";");
  printString(toStringInt32(constStream(99).tail.tail.head));
  printString(";");
  printString(toStringInt32(fib.tail.tail.tail.tail.tail.head));
  printString(";");
  printString(toStringInt32(drop2(streamZipWith(addInt32, nats(3), constStream(10))).head))
}
