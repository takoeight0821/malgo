#malgo-2025
module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- Apply chaining: #(x)(y)(z) - curried codata
type F1 = { apply: Int32 -> Int32 -> Int32 -> Int32 }

def addThree = {
  #(x)(y)(z).apply -> addInt32(addInt32(x, y), z)
}

def main = { _ ->
  printString(toStringInt32(addThree(1)(2)(3).apply))
}
