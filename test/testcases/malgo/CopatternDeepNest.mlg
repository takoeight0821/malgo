#malgo-2025
module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- Deep nested field copattern: #.a.b.c
type Inner = { val: Int32 }
type Middle = { inner: Inner }
type Outer = { middle: Middle }

def nested = {
  #.middle.inner.val -> 42
}

def main = { _ ->
  printString(toStringInt32(nested.middle.inner.val))
}
