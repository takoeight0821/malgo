module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

infixl 6 (+)
def (+) = { x y -> addInt32 x y }

infixl 7 (*)
def (*) = { x y -> mulInt32 x y }

def apply : (a -> b) -> a -> b
def apply = { f x -> f x }

def flip : (a -> b -> c) -> b -> a -> c
def flip = { f x y -> f y x }

def main = {
  -- apply
  putStr "apply (+1) 41 = ";
  putStrLn (toStringInt32 (apply { x -> x + 1 } 41));

  -- flip
  putStr "flip sub 3 10 = ";
  putStrLn (toStringInt32 (flip subInt32 3 10));

  -- const
  putStr "const 42 99 = ";
  putStrLn (toStringInt32 (const 42 99));

  -- compose with pipe
  putStr "42 |> (+1) |> (*2) = ";
  42 |> { x -> x + 1 } |> { x -> x * 2 } |> toStringInt32 |> putStrLn
}
