#malgo-2025
module {..} = import "../../../runtime/malgo/Builtin.mlg"

def printI64 = { x ->
  printString# (toStringInt64# x)
}

-- Continuation-capture shape (covered by parser/IR-stage goldens).
def captureContinuationShape = { x -> label k goto(x, k) }

-- Nested non-local control shape across labels.
def nestedNonLocalShape = { x ->
  label exit (
    label inner (
      goto(x, exit)
    )
  )
}

-- Evaluated goto path in current runtime semantics (target is a function value).
def viaFunctionGoto = { x ->
  goto(x, { y -> y })
}

-- Evaluated label path.
def passThroughLabel = { x ->
  label k x
}

def main = {
  printI64 (passThroughLabel 6i64#);
  printI64 (viaFunctionGoto 7i64#);
  printI64 (label k 8i64#)
}
