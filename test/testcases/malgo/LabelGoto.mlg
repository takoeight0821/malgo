module {..} = import "../../../runtime/malgo/Builtin.mlg"

-- label/goto syntax test
-- label creates a continuation capture (mu in sequent calculus)
-- label k body ≡ mu k. body (captures current continuation as k)

-- Test 1: label captures continuation and returns value directly
def main = {
  printString# (toStringInt64#
    (label k 42i64#))
}
