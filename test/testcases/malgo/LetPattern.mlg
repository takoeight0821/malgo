-- let-patterns: bind a non-variable pattern in a `let` statement. Desugars to
-- `case e { pat -> rest }` in the renamer. Covers record and constructor
-- patterns; a bare-variable `let` keeps its dedicated form.
module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

data Pair a b = Pair a b

def mkRec = { a b -> {fst = a, snd = b} }

def main = {
  let {fst = x, snd = y} = mkRec "hello" "world";
  let (Pair p q) = Pair x y;
  let _ = putStrLn p;
  putStrLn q
}
