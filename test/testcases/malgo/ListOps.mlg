module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

infixl 6 (+)
def (+) = { x y -> addInt32 x y }

def emptyList : List Int32
def emptyList = Nil

def main = {
  -- null
  putStr "null [] = ";
  if (null emptyList) { putStrLn "True" } { putStrLn "False" };

  putStr "null [1] = ";
  if (null [1]) { putStrLn "True" } { putStrLn "False" };

  -- any / all
  let xs = [1, 2, 3, 4, 5];

  putStr "any (==3) [1..5] = ";
  if (any { x -> eqInt32 x 3 } xs) { putStrLn "True" } { putStrLn "False" };

  putStr "any (==6) [1..5] = ";
  if (any { x -> eqInt32 x 6 } xs) { putStrLn "True" } { putStrLn "False" };

  putStr "all (>0) [1..5] = ";
  if (all { x -> gtInt32 x 0 } xs) { putStrLn "True" } { putStrLn "False" };

  putStr "all (>3) [1..5] = ";
  if (all { x -> gtInt32 x 3 } xs) { putStrLn "True" } { putStrLn "False" };

  -- replicate
  putStr "length (replicate 5 0) = ";
  putStrLn (toStringInt32 (length (replicate 5 0)));

  -- take / drop
  putStr "head (take 3 [1..5]) = ";
  putStrLn (toStringInt32 (head (take 3 xs)));

  putStr "head (drop 3 [1..5]) = ";
  putStrLn (toStringInt32 (head (drop 3 xs)));

  -- zip
  let pairs = zip [1, 2, 3] [10, 20, 30];
  let p = head pairs;
  putStr "head (zip [1,2,3] [10,20,30]) = (";
  putStr (toStringInt32 (fst p));
  putStr ", ";
  putStr (toStringInt32 (snd p));
  putStrLn ")"
}
