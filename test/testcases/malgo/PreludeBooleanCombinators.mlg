module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

def showBool : Bool -> String
def showBool =
  { True -> "True",
    False -> "False" }

def main = { () ->
  putStrLn (showBool (True && True));
  putStrLn (showBool (True && False));
  putStrLn (showBool (False && True));
  putStrLn (showBool (False && False));
  putStrLn (showBool (True || True));
  putStrLn (showBool (True || False));
  putStrLn (showBool (False || True));
  putStrLn (showBool (False || False));
  putStrLn (showBool (isAlphanum (Char# 'a'#) || eqChar (Char# 'a'#) (Char# '_'#) || eqChar (Char# 'a'#) (Char# '-'#)));
  putStrLn (showBool (isAlphanum (Char# '_'#) || eqChar (Char# '_'#) (Char# '_'#) || eqChar (Char# '_'#) (Char# '-'#)));
  putStrLn (showBool (isAlphanum (Char# '!'#) || eqChar (Char# '!'#) (Char# '_'#) || eqChar (Char# '!'#) (Char# '-'#)));
  putStrLn (showBool (allString isAlphanum "abc123"));
  putStrLn (showBool (allString isAlphanum "abc 123"));
  putStrLn (showBool (allString isAlphanum ""))
}
