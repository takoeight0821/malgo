module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

def showBool : Bool -> String
def showBool =
  { True -> "True",
    False -> "False" }

def showList : List String -> String
def showList = { xs -> appendString "[" (appendString (concatString (punctuate ", " xs)) "]") }

def main = { () ->
  putStrLn (showBool (stringContains "plugin-x" "a\nplugin-x\nb"));
  putStrLn (showBool (stringContains "zzz" "a\nplugin-x\nb"));
  putStrLn (showBool (stringContains "" "abc"));
  putStrLn (showBool (stringContains "abc" ""));
  putStrLn (appendString "[" (appendString (trimTrailingNewlines "abc\n\n\n") "]"));
  putStrLn (appendString "[" (appendString (trimTrailingNewlines "abc") "]"));
  putStrLn (showList (words "  hello   world  foo "));
  putStrLn (showList (words ""));
  putStrLn (showList (lines "a\nb\n"));
  putStrLn (showList (lines "a\nb"));
  putStrLn (showList (lines "a\n\nb"));
  putStrLn (showList (lines ""));
  putStrLn (appendString "[" (appendString (unlines (Cons "a" (Cons "b" Nil))) "]"));
  putStrLn (appendString "[" (appendString (unlines Nil) "]"))
}
