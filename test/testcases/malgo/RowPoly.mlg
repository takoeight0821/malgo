module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- Test row-polymorphic type annotations
-- Record: { field: Type | rowVar }
-- Variant: [Con Type | rowVar]

-- Row-polymorphic record type: extract a field from any record with "x"
def getX : { x: Int64# | r } -> Int64#
def getX = { rec -> rec.x }

-- Variant type annotation with data definition
data Option a = Some a | None

def handleVal : [Some Int64# | r] -> Int64#
def handleVal = { (Some x) -> x }

def main = { (_) ->
  printString# (toStringInt64# (getX { x = 10i64# }))
}
