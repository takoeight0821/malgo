module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

infixr 6 (<>)
def (<>) : String -> String -> String
def (<>) = appendString

def main = {
  let str = "Hello, World!";

  putStr "string: ";
  putStrLn str;

  putStr "length: ";
  putStrLn (toStringInt64 (lengthString str));

  putStr "charAt(0): ";
  printChar (atString 0i64 str);
  newline ();

  putStr "substring(0,5): ";
  putStrLn (substring str 0i64 5i64);

  putStr "concat: ";
  putStrLn ("foo" <> "-" <> "bar" <> "-" <> "baz");

  putStr "consString: ";
  putStrLn (consString (Char# 'X'#) "YZ")
}
