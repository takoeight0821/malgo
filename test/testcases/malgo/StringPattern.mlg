-- String literal patterns: match a string scrutinee directly in clause heads,
-- with a wildcard fallthrough. Matching is structural (a computed string
-- equal to a literal still matches), exercising the String# wrapper desugaring.
module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

def classify = {
  "red"   -> "stop",
  "green" -> "go",
  "amber" -> "slow",
  _       -> "unknown"
}

def main = {
  let _ = putStrLn (classify "red");
  let _ = putStrLn (classify "green");
  let _ = putStrLn (classify (appendString "am" "ber"));
  putStrLn (classify "blue")
}
