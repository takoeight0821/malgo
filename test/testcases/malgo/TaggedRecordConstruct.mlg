module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- #422: `Point { .x -> v, .y -> w }` merges the tag and record fields into
-- one value, rather than nesting the whole record inside the tag as a
-- single positional slot.
data Point = Point { x: Int32, y: Int32 }

def sumPoint = { Point { .x -> x, .y -> y } -> addInt32(x, y) }

def main = {
  printString (toStringInt32 (sumPoint (Point { .x -> 4, .y -> 9 })))
}
