module {..} = import "../../../runtime/malgo/Builtin.mlg"

-- Companion to TaggedRecordCrossModuleUse.mlg: declares a record-shaped
-- constructor (#422) in a module OTHER than the one that pattern-matches it
-- with tagged-record syntax, confirming cross-module tagged-record matching
-- needs no per-module field-order table — matching is purely structural (by
-- field name, via `Fun.Pattern.expand`), so there is no cross-module gap to
-- begin with.
data Point = Point { x: Int32, y: Int32 }
