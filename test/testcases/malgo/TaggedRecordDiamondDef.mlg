module {..} = import "../../../runtime/malgo/Builtin.mlg"

-- Companion to TaggedRecordDiamondMid.mlg/TaggedRecordDiamondUse.mlg: like
-- TaggedRecordCrossModuleDef.mlg/CrossModuleUse.mlg, but reached by two
-- paths from Use -- directly, and transitively through
-- TaggedRecordDiamondMid.mlg -- exercising the same diamond-dependency
-- shape as Prelude.mlg's own `module {..} = import Builtin` (the pattern
-- #429's buildDepsEnv identity-confusion bug was about), but for a
-- user-defined module chain instead of the hardcoded Builtin/Prelude one.
data Point = Point { x: Int32, y: Int32 }
