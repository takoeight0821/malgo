module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "./TaggedRecordDiamondDef.mlg"

-- Depends on TaggedRecordDiamondDef.mlg for its own use (not to re-export
-- Point's name -- a wildcard import does not propagate names to further
-- importers, confirmed empirically while building this fixture: a module
-- that only imports this one can't name Point). What this module DOES
-- contribute to the diamond shape below is TaggedRecordDiamondDef.mlg
-- appearing in this module's own `rnState.dependencies` -- so a module
-- that imports both this one and TaggedRecordDiamondDef.mlg directly (see
-- TaggedRecordDiamondUse.mlg) reaches TaggedRecordDiamondDef.mlg by two
-- paths, the same diamond shape as importing both Builtin and Prelude
-- directly (#429).
def originPoint = { (_) -> Point { .x -> 0, .y -> 0 } }
