#c-style-apply
module {..} = import "../../../runtime/malgo/Builtin.mlg"
module {..} = import "../../../runtime/malgo/Prelude.mlg"

-- C-style data definition, kept as a syntax variant even though the
-- Regular-syntax equivalent now parses too (see examples/malgo/BinaryTree.mlg).
data Tree(a) = Leaf() | Node(Tree(a), a, Tree(a))

-- insert: the if-guarded reconstruction pattern the reuse pass targets --
-- match Leaf/Node, recurse into exactly one branch chosen by an `if`, then
-- rebuild a `Node` from the recursive result.
def insert : Int32 -> Tree Int32 -> Tree Int32
def insert = {
  x Leaf -> Node Leaf x Leaf,
  x (Node left val right) ->
    if (ltInt32 x val)
      { Node (insert x left) val right }
      { if (gtInt32 x val)
          { Node left val (insert x right) }
          { Node left val right }
      }
}

def inorder : Tree Int32 -> List Int32
def inorder = {
  Leaf -> Nil,
  (Node left val right) -> append (inorder left) (Cons val (inorder right))
}

def showList : List Int32 -> String
def showList =
  { Nil -> "",
    (Cons x Nil) -> toStringInt32 x,
    (Cons x xs) -> appendString (toStringInt32 x) (appendString " " (showList xs))
  }

def main = {
  let xs = [5, 3, 8, 1, 4, 7, 9, 2, 6];
  let tree = foldl { t x -> insert x t } Leaf xs;

  putStr "Inorder: ";
  putStrLn (showList (inorder tree))
}
